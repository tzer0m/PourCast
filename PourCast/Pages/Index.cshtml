@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<p id="status" class="status">Finding Your Location…</p>
<div id="dashboard" class="dashboard" hidden>
<section id="summary" class="summary"></section>
<section id="hourly" class="card">
    <div class="legend">
        <span style="--key: var(--temperature)">Temp</span>
        <span class="key-dashed" style="--key: var(--feels-like)">FL</span>
        <span style="--key: rgb(var(--rain))">Rain</span>
        <span class="key-dashed" style="--key: rgb(var(--rain))">R%</span>
        <span style="--key: var(--uv)">UV</span>
        <span class="key-dotted" style="--key: var(--uv)">CSUV</span>
        <span style="--key: var(--humidity)">H%</span>
        <span style="--key: var(--wind)">Wind</span>
        <span class="key-dashed" style="--key: var(--wind)">Gust</span>
    </div>
    <div class="chart">
        <svg id="axis" class="axis"></svg>
        <div id="strip-scroll" class="strip-scroll">
            <svg id="strip" class="strip"></svg>
        </div>
    </div>
</section>
</div>
@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}