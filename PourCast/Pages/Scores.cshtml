@page
@model ScoresModel
@using PourCast.Scoring.Models
@using System.Globalization
@{
    ViewData["Title"] = "Forecast Accuracy";
    int days = Model.Settings.SnapshotDays;
    bool showCommon = Model.CommonDays > 0 && Model.CommonDays < days;
    string commonLabel = Model.CommonDays == 1 ? "Day 1" : $"Days 1–{Model.CommonDays}";
}
<header class="topbar">
    <a class="place" href="/">
        <img class="place-logo" src="~/app-icons/icon-192.png" alt="PourCast" width="36" height="36" />
        <h1 class="place-name">Forecast Accuracy</h1>
        <span class="place-detail">@Model.Settings.Name (@Model.Settings.Station) · Last @Model.Settings.WindowDays Days · @Model.ObservedHours Observed Hours</span>
    </a>
</header>
<section class="card scores-card">
    @if (Model.Scores.Count == 0)
    {
        <p class="status">Collecting forecasts and observations. Scores appear once a day of forecasts can be checked.</p>
    }
    else
    {
        <div class="scores-scroll">
            <table class="scores">
                <thead>
                    <tr>
                        <th class="scores-source" aria-sort="none"><button type="button" class="scores-sort" data-type="text">Source</button></th>
                        <th aria-sort="descending" title="Compared with the other sources on the same days and metrics"><button type="button" class="scores-sort">Overall</button></th>
                        @if (showCommon)
                        {
                            <th class="scores-common" aria-sort="none" title="Plain average over the days every source covers"><button type="button" class="scores-sort">@commonLabel</button></th>
                        }
                        @for (int day = 1; day <= days; day++)
                        {
                            <th aria-sort="none"><button type="button" class="scores-sort">Day @day</button></th>
                        }
                    </tr>
                </thead>
                @foreach (SourceScore source in Model.Scores)
                {
                    <tbody class="scores-group">
                        <tr class="scores-row">
                            <th class="scores-source">
                                <button type="button" class="scores-toggle" aria-expanded="false">@source.Source</button>
                            </th>
                            @if (source.Overall is double overall)
                            {
                                string skill = source.Skill is double points ? $"{points:+0.0;-0.0;0.0} vs the other sources on the same days and metrics" : "Nothing to compare with yet";
                                <td class="score score-overall" style="--score: @overall.ToString("0")" title="@skill" data-value="@overall.ToString(CultureInfo.InvariantCulture)">@overall.ToString("0")</td>
                            }
                            else
                            {
                                <td class="score score-empty">Collecting</td>
                            }
                            @if (showCommon)
                            {
                                if (source.CommonOverall is double common)
                                {
                                    <td class="score scores-common" style="--score: @common.ToString("0")" data-value="@common.ToString(CultureInfo.InvariantCulture)">@common.ToString("0")</td>
                                }
                                else
                                {
                                    <td class="score score-empty scores-common">–</td>
                                }
                            }
                            @for (int day = 1; day <= days; day++)
                            {
                                DayScore? dayScore = source.Days.FirstOrDefault(x => x.Day == day);
                                if (dayScore is null)
                                {
                                    <td class="score score-empty">–</td>
                                }
                                else
                                {
                                    <td class="score" style="--score: @dayScore.Overall.ToString("0")" title="@dayScore.Matches Hours Compared" data-value="@dayScore.Overall.ToString(CultureInfo.InvariantCulture)">@dayScore.Overall.ToString("0")</td>
                                }
                            }
                        </tr>
                        @foreach (ScoreMetric metric in Model.Metrics)
                        {
                            <tr class="scores-detail" hidden>
                                <th class="scores-source scores-metric">@ScoresModel.MetricName(metric)</th>
                                <td></td>
                                @if (showCommon)
                                {
                                    <td class="scores-common"></td>
                                }
                                @for (int day = 1; day <= days; day++)
                                {
                                    MetricScore? metricScore = source.Days.FirstOrDefault(x => x.Day == day)?.Metrics.GetValueOrDefault(metric);
                                    if (metricScore is null)
                                    {
                                        <td class="score score-empty">–</td>
                                    }
                                    else
                                    {
                                        <td class="score score-detail" style="--score: @metricScore.Score.ToString("0")" title="Score @metricScore.Score.ToString("0") · @metricScore.Matches Hours">@ScoresModel.FormatError(metric, metricScore.Error)</td>
                                    }
                                }
                            </tr>
                        }
                        <tr class="scores-detail" hidden>
                            <th class="scores-source scores-metric">Rain Hit Rate</th>
                            <td></td>
                            @if (showCommon)
                            {
                                <td class="scores-common"></td>
                            }
                            @for (int day = 1; day <= days; day++)
                            {
                                double? hitRate = source.Days.FirstOrDefault(x => x.Day == day)?.RainHitRate;
                                <td class="score score-plain">@(hitRate is double rate ? $"{rate:0}%" : "–")</td>
                            }
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <p class="scores-note">@Model.ScoresNote(showCommon ? commonLabel : null)</p>
    }
</section>
@section Scripts {
    <script type="module" src="~/js/scores.js" asp-append-version="true"></script>
}