{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Providers": {
    "MetOffice": {
      "BaseUrl": "https://data.hub.api.metoffice.gov.uk/sitespecific/v0/",
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "MetOffice",
      "DailyLimit": 360
    },
    "OpenMeteo": {
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "OpenMeteoEnsemble": {
      "BaseUrl": "https://ensemble-api.open-meteo.com/",
      "Model": "gfs05",
      "ForecastDays": 35,
      "CacheMinutes": 60,
      "Ranges": [ "Month" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    }
  },
  "Usage": {
    "FilePath": "usage.json"
  },
  "Geocoding": {
    "BaseUrl": "https://geocoding-api.open-meteo.com/",
    "ResultCount": 8,
    "CacheMinutes": 1440,
    "UsageKey": "OpenMeteo",
    "DailyLimit": 10000
  }
}
