{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Providers": {
    "MetOffice": {
      "BaseUrl": "https://data.hub.api.metoffice.gov.uk/sitespecific/v0/",
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "MetOffice",
      "DailyLimit": 360
    },
    "OpenMeteoUkmo": {
      "Name": "Open-Meteo UKMO",
      "Model": "ukmo_seamless",
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "OpenMeteoEcmwf": {
      "Name": "Open-Meteo ECMWF",
      "Model": "ecmwf_ifs025",
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "OpenMeteoIcon": {
      "Name": "Open-Meteo ICON",
      "Model": "icon_seamless",
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "OpenMeteoGfs": {
      "Name": "Open-Meteo GFS",
      "Model": "gfs_seamless",
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "OpenMeteoMeteoFrance": {
      "Name": "Open-Meteo Météo-France",
      "Model": "meteofrance_seamless",
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    },
    "MetNorway": {
      "BaseUrl": "https://api.met.no/",
      "UserAgent": "PourCast/1.0 (+https://github.com/tzer0m/PourCast)",
      "CacheMinutes": 30,
      "Ranges": [ "Week" ],
      "UsageKey": "MetNorway"
    },
    "PirateWeather": {
      "BaseUrl": "https://api.pirateweather.net/",
      "CacheMinutes": 30,
      "Ranges": [ "Week" ],
      "UsageKey": "PirateWeather",
      "DailyLimit": 300
    },
    "TomorrowIo": {
      "BaseUrl": "https://api.tomorrow.io/",
      "CacheMinutes": 60,
      "Ranges": [ "Week" ],
      "UsageKey": "TomorrowIo",
      "DailyLimit": 500
    },
    "WeatherApi": {
      "BaseUrl": "https://api.weatherapi.com/",
      "ForecastDays": 3,
      "CacheMinutes": 30,
      "Ranges": [ "Week" ],
      "UsageKey": "WeatherApi",
      "DailyLimit": 3000
    },
    "OpenMeteoEnsemble": {
      "BaseUrl": "https://ensemble-api.open-meteo.com/",
      "Model": "gfs05",
      "ForecastDays": 35,
      "CacheMinutes": 60,
      "Ranges": [ "Month" ],
      "UsageKey": "OpenMeteo",
      "DailyLimit": 10000
    }
  },
  "Combining": {
    "PercentileMinimumSources": 6,
    "LowPercentile": 0.1,
    "HighPercentile": 0.9,
    "EnsembleLowPercentile": 0.1,
    "EnsembleHighPercentile": 0.9,
    "CalculateFeelsLike": true,
    "WindChillFullAt": 15,
    "WindChillFadeTo": 20,
    "HeatIndexFadeFrom": 24,
    "HeatIndexFullAt": 27
  },
  "Usage": {
    "FilePath": "usage.json",
    "DefaultCooldownMinutes": 15,
    "FailureCacheMinutes": 2
  },
  "Geocoding": {
    "BaseUrl": "https://geocoding-api.open-meteo.com/",
    "ResultCount": 8,
    "CacheMinutes": 1440,
    "UsageKey": "OpenMeteo",
    "DailyLimit": 10000
  }
}
