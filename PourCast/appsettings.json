{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Providers": {
    "MetOffice": {
      "BaseUrl": "https://data.hub.api.metoffice.gov.uk/sitespecific/v0/",
      "CacheMinutes": 15,
      "Ranges": [ "Week" ]
    },
    "OpenMeteo": {
      "BaseUrl": "https://api.open-meteo.com/",
      "ForecastDays": 8,
      "CacheMinutes": 15,
      "Ranges": [ "Week" ]
    },
    "OpenMeteoEnsemble": {
      "BaseUrl": "https://ensemble-api.open-meteo.com/",
      "Model": "gfs05",
      "ForecastDays": 35,
      "CacheMinutes": 60,
      "Ranges": [ "Month" ]
    }
  },
  "Geocoding": {
    "BaseUrl": "https://geocoding-api.open-meteo.com/",
    "ResultCount": 8,
    "CacheMinutes": 1440
  }
}
